# ScamShield AI - Backend environment configuration example
# Copy this file to ".env" and adjust values as needed.
# No API keys are required - this project uses only local heuristics.

# Comma-separated list of allowed CORS origins for production.
# Leave unset for local development (safe local defaults are used automatically).
# Example for production:
# ALLOWED_ORIGINS=https://your-frontend-domain.com
ALLOWED_ORIGINS=
